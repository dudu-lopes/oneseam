{
  "productName": "ONESEAM",
  "version": "1.0.0",
  "identifier": "com.oneseam.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node ../dev-server.js"
  },
  "app": {
    "windows": [
      {
        "title": "ONESEAM",
        "width": 520,
        "height": 860,
        "resizable": false,
        "decorations": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.svg", "icons/icon.ico"],
    "resources": [
      "backend/oneseam_backend.exe",
      "backend/oneseam_blind_matching.py",
      "backend/oneseam_config.yaml",
      "backend/shard_signing_pub.pem"
    ]
  }
}
