# Runtime mode
ONESEAM_ENV=development
ONESEAM_CONFIG=oneseam_config.yaml

# CLI signing (optional)
ONESEAM_WALLET_PRIVATE_KEY=

# API security (production)
ONESEAM_ADMIN_UI=0
ONESEAM_CLI_ADVANCED=0

# Local test mode (single host)
ONESEAM_LOCAL_TEST=0

# External verifier / chain integrations
PROOF_VERIFIER_URL=
PROOF_VERIFIER_AUTH_TOKEN=
BTC_RPC_URL=
BTC_RPC_USER=
BTC_RPC_PASSWORD=
